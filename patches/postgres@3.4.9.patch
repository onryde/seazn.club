diff --git a/cf/src/connection.js b/cf/src/connection.js
index 8e79170aeb13efe8c3c77ccede0cd3a115b5e1b5..3fd71edbf92859a980d977a0366162bb38f3d48c 100644
--- a/cf/src/connection.js
+++ b/cf/src/connection.js
@@ -172,11 +172,18 @@ function Connection(options, queues = {}, { onopen = noop, onend = noop, onclose
         : (query = q, query.active = true)
 
       build(q)
-      return write(toBuffer(q))
+      // seazn.club patch (patches/postgres@3.4.9.patch). `onexecute` is sql.begin's reservation of this connection, and the
+      // statement is on the wire from here whatever the checks below answer, so the hook runs for every statement written.
+      // As the last term of the chain it was skipped for a BEGIN written as the statement that filled the pipeline
+      // (`sent.length < max_pipeline` false) or while the socket was over its high-water mark (`write` false): the BEGIN
+      // still ran, CommandComplete raised UNSAFE_TRANSACTION, and the connection went back to the pool inside the open
+      // transaction. The return value is the original one: false when the checks are, else whatever the hook answers.
+      const room = write(toBuffer(q))
         && !q.describeFirst
         && !q.cursorFn
         && sent.length < max_pipeline
-        && (!q.options.onexecute || q.options.onexecute(connection))
+      const claimed = !q.options.onexecute || q.options.onexecute(connection)
+      return room && claimed
     } catch (error) {
       sent.length === 0 && write(Sync)
       errored(error)
