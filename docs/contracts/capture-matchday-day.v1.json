{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seazn.club/contracts/capture-matchday-day.v1.json",
  "title": "Seazn Match Day code day read, v1: GET /api/v1/match-day-code",
  "description": "What a phone holding a Match Day code lists (capture S4 Match Day design 2026-11-07 §5, §9.3; MD-1 Task 3), authenticated by Authorization: Bearer md_… only. The answer is `data` in the v1 envelope {ok: true, data, requestId}; $defs.refusal is `error` in {ok: false, error, requestId}. It never carries the code's token or any scoring link. Vendored into the capture repo; its sha256, parity with its zod twin and its fixtures are pinned by apps/web/src/server/api-v1/__tests__/capture-contract.test.ts.",
  "type": "object",
  "properties": {
    "competition": {
      "description": "The competition the code was minted for: its id and name.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "additionalProperties": false
    },
    "scope": {
      "description": "The code's scope: kind competition (every court, and the matches with no court), venue (that venue's courts) or courts (exactly those courts). label is what the header shows: the competition's name, the venue's name, or the courts' names joined with \", \" in the board's order.",
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "competition",
            "venue",
            "courts"
          ]
        },
        "label": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "label"
      ],
      "additionalProperties": false
    },
    "day": {
      "description": "The day the code is good for, YYYY-MM-DD, in tz.",
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "tz": {
      "description": "The IANA zone the day is in: the competition's organisation's zone (one zone per code).",
      "type": "string",
      "minLength": 1
    },
    "opens_at": {
      "description": "00:00 of day in tz, as a UTC instant. Before it the code answers 403 MD_NOT_OPEN.",
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "expires_at": {
      "description": "24:00 of day in tz, as a UTC instant. From it the code answers 410 MD_ENDED.",
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
