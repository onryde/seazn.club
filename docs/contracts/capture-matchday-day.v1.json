            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "division_name": {
            "type": "string"
          },
          "label": {
            "description": "The stage's name.",
            "type": "string"
          },
          "round": {
            "description": "swiss only: the round awaiting pairing (the phone's \"Round 4 pairings are ready\"); null for a draw.",
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "kind",
          "stage_id",
          "division_name",
          "label",
          "round"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "competition",
    "scope",
    "day",
    "tz",
    "opens_at",
    "expires_at",
    "can_approve",
    "courts",
    "no_court",
    "online",
    "approvals"
  ],
  "additionalProperties": false,
  "$defs": {
    "refusal": {
      "description": "Every refusal, the envelope's error: 401 MD_UNKNOWN (no such code, or no md_ bearer), 410 MD_WITHDRAWN, 410 MD_ENDED, 403 MD_NOT_OPEN (with opens_at). The open and the approvals answer MD_OUT_OF_SCOPE, MD_NO_APPROVE, MD_STALE, MD_ALREADY and MD_TIES too. A 429 RATE_LIMITED (with Retry-After) is the v1 envelope's own answer, outside this shape.",
      "type": "object",
      "properties": {
        "code": {
          "description": "The machine word the phone keys its copy on: one of the plan's MD_ words, a closed list. The v1 envelope's own answers (429 RATE_LIMITED, 404 NOT_FOUND, 500 INTERNAL) are not md_ refusals and are outside this shape; the phone reads them by status.",
          "type": "string",
          "enum": [
            "MD_UNKNOWN",
            "MD_WITHDRAWN",
            "MD_ENDED",
            "MD_NOT_OPEN",
            "MD_OUT_OF_SCOPE",
            "MD_NO_APPROVE",
            "MD_STALE",
            "MD_ALREADY",
            "MD_TIES"
          ]
        },
        "message": {
          "description": "A plain English developer string; the phone never shows it.",
          "type": "string"
        },
        "opens_at": {
          "description": "MD_NOT_OPEN only: when the code's day starts, as a UTC instant.",
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "additionalProperties": false
    }
  }
}
