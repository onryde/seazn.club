{
  "name": "@onryde/seazn-engine",
  "version": "0.1.0",
  "type": "module",
  "description": "Pure tournament engine for seazn.club — zero effectful deps (design corpus: engine/).",
  "license": "SEE LICENSE IN LICENSE.md",
  "repository": {
    "type": "git",
    "url": "https://github.com/onryde/seazn.club",
    "directory": "packages/engine"
  },
  "exports": {
    "./core": "./src/core/index.ts",
    "./sport": "./src/sport/index.ts",
    "./sports": "./src/sports/index.ts",
    "./sports/*": "./src/sports/*/index.ts",
    "./stats": "./src/stats/index.ts",
    "./competition": "./src/competition/index.ts",
    "./exports": "./src/exports/index.ts",
    "./history": "./src/history/index.ts",
    "./import": "./src/import/index.ts",
    "./officials": "./src/officials/index.ts",
    "./scheduling": "./src/scheduling/index.ts",
    "./scheduling/bracket-layout": "./src/scheduling/bracket-layout.ts",
    "./scheduling/calendar": "./src/scheduling/calendar.ts",
    "./scheduling/court-windows": "./src/scheduling/court-windows.ts",
    "./scheduling/capacity": "./src/scheduling/capacity.ts",
    "./scheduling/grid-step": "./src/scheduling/grid-step.ts",
    "./scheduling/health": "./src/scheduling/health.ts",
    "./scheduling/rest-floor": "./src/scheduling/rest-floor.ts",
    "./scheduling/swiss": "./src/scheduling/swiss.ts",
    "./scheduling/tz": "./src/scheduling/tz.ts",
    "./testkit": "./src/testkit/index.ts",
    "./phone-subpaths.json": "./phone-subpaths.json"
  },
  "files": [
    "dist",
    "rules",
    "phone-subpaths.json"
  ],
  "sideEffects": false,
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "exports": {
      "./core": {
        "types": "./dist/core/index.d.ts",
        "default": "./dist/core/index.js"
      },
      "./sport": {
        "types": "./dist/sport/index.d.ts",
        "default": "./dist/sport/index.js"
      },
      "./sports": {
        "types": "./dist/sports/index.d.ts",
        "default": "./dist/sports/index.js"
      },
      "./sports/*": {
        "types": "./dist/sports/*/index.d.ts",
        "default": "./dist/sports/*/index.js"
      },
      "./stats": {
        "types": "./dist/stats/index.d.ts",
        "default": "./dist/stats/index.js"
      },
      "./competition": {
        "types": "./dist/competition/index.d.ts",
        "default": "./dist/competition/index.js"
      },
      "./exports": {
        "types": "./dist/exports/index.d.ts",
        "default": "./dist/exports/index.js"
      },
      "./history": {
        "types": "./dist/history/index.d.ts",
        "default": "./dist/history/index.js"
      },
      "./import": {
        "types": "./dist/import/index.d.ts",
        "default": "./dist/import/index.js"
      },
      "./officials": {
        "types": "./dist/officials/index.d.ts",
        "default": "./dist/officials/index.js"
      },
      "./scheduling": {
        "types": "./dist/scheduling/index.d.ts",
        "default": "./dist/scheduling/index.js"
      },
      "./scheduling/bracket-layout": {
        "types": "./dist/scheduling/bracket-layout.d.ts",
        "default": "./dist/scheduling/bracket-layout.js"
      },
      "./scheduling/calendar": {
        "types": "./dist/scheduling/calendar.d.ts",
        "default": "./dist/scheduling/calendar.js"
      },
      "./scheduling/court-windows": {
        "types": "./dist/scheduling/court-windows.d.ts",
        "default": "./dist/scheduling/court-windows.js"
      },
      "./scheduling/capacity": {
        "types": "./dist/scheduling/capacity.d.ts",
        "default": "./dist/scheduling/capacity.js"
      },
      "./scheduling/grid-step": {
        "types": "./dist/scheduling/grid-step.d.ts",
        "default": "./dist/scheduling/grid-step.js"
      },
      "./scheduling/health": {
        "types": "./dist/scheduling/health.d.ts",
        "default": "./dist/scheduling/health.js"
      },
      "./scheduling/rest-floor": {
        "types": "./dist/scheduling/rest-floor.d.ts",
        "default": "./dist/scheduling/rest-floor.js"
      },
      "./scheduling/swiss": {
        "types": "./dist/scheduling/swiss.d.ts",
        "default": "./dist/scheduling/swiss.js"
      },
      "./scheduling/tz": {
        "types": "./dist/scheduling/tz.d.ts",
        "default": "./dist/scheduling/tz.js"
      },
      "./testkit": {
        "types": "./dist/testkit/index.d.ts",
        "default": "./dist/testkit/index.js"
      },
      "./phone-subpaths.json": "./phone-subpaths.json"
    }
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "sim": "vitest run src/testkit/simulation.test.ts src/testkit/chaos.test.ts src/testkit/undo-sweep.test.ts",
    "sim:replay": "node --experimental-strip-types scripts/sim-replay.ts",
    "schema:snapshot": "node --experimental-strip-types scripts/schema-snapshot.ts",
    "typecheck": "node ../../node_modules/typescript-native/bin/tsc --noEmit",
    "build:dist": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && node ../../node_modules/typescript-native/bin/tsc -p tsconfig.build.json",
    "boundary": "node --experimental-strip-types scripts/engine-boundary.ts",
    "pack:proof": "node pack-proof/run.mjs",
    "lint": "eslint",
    "sim:matrix": "node --experimental-strip-types scripts/sim-replay.ts --matrix",
    "mutation": "stryker run stryker.config.mjs",
    "mutation:floor": "node --experimental-strip-types scripts/stryker-floor.ts",
    "mutation:recut": "node scripts/stryker-recut.mjs"
  },
  "peerDependencies": {
    "fast-check": "^3",
    "vitest": "^4.1.11",
    "zod": "^4.4.3"
  },
  "peerDependenciesMeta": {
    "fast-check": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@types/node": "^26",
    "eslint": "^9",
    "fast-check": "^3",
    "typescript": "6.0.3",
    "typescript-eslint": "^8",
    "typescript-native": "npm:typescript@7.0.2",
    "vitest": "^4.1.11",
    "zod": "^4.4.3"
  }
}
