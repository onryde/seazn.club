{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    // The lint is type-aware (recommendedTypeChecked) over the engine's types, imported as `@seazn/engine` (the alias key; the
    // package's name is @onryde/seazn-engine; the solver port, the clock), so its cache key must move with the engine as
    // typecheck's does (the same review M-4 that packages/reference/turbo.json answers). Since engine split 2b the engine is
    // a registry package, not a workspace one, so there is no @onryde/seazn-engine#build task for `^build` to reach: turbo
    // keys the engine through this package's external-dependency hash, i.e. the version pnpm-lock.yaml resolves. `^build`
    // stays for any workspace dependency this package gains.
    "lint": {
      "dependsOn": ["^build"]
    }
  }
}
