{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    // The lint is type-aware (recommendedTypeChecked) over `@seazn/engine/core`
    // types (the alias key; the package's name is @onryde/seazn-engine), so its
    // cache key must hold the engine's sources as typecheck's does: `^build`
    // puts @onryde/seazn-engine#build (whose inputs are the engine package's
    // files, read as src by workspace consumers) in the hash. Without it an engine type change could
    // restore a stale green lint from the remote cache (review M-4).
    // Pinned by tools/matrix/__tests__/workspace-wiring.test.ts.
    "lint": {
      "dependsOn": ["^build"]
    }
  }
}
