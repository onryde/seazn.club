# Copy to .env.local and fill in. See AGENTS.md / docs/superpowers for detail.
#
# Everything uncommented below is read by running application code. The
# commented blocks at the bottom are CI-, e2e- or bench-only and should NOT
# be set on a production machine.

# --- Core ---
DATABASE_URL=
DATABASE_SSL=
# Namespaces the schema (and the platform-settings cache key) — see lib/db.ts.
DB_SCHEMA=
DB_POOL_MAX=20
AUTH_SECRET=
# OAUTH_BASE_URL wins over NEXT_PUBLIC_BASE_URL for server-side redirect and
# canonical-URL resolution (lib/site-origin.ts) — Fly's proxy makes req.url the
# internal binding, so this must be set explicitly in prod.
OAUTH_BASE_URL=
NEXT_PUBLIC_BASE_URL=

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Realtime spectator JWT signing (lib/realtime.ts resolveRealtimeMintKey).
# This project uses Supabase ASYMMETRIC signing keys (JWKS ES256).
# Preferred: PKCS8 PEM or private JWK JSON of an imported signing key.
SUPABASE_JWT_PRIVATE_KEY=
# Optional, PEM branch only — the JWK branch takes the kid from the key itself.
SUPABASE_JWT_KID=
# Legacy fallback (long random shared secret). A UUID-shaped value here is a
# known misconfig: it is the JWKS kid, not a secret, and mints HS256 that
# Supabase rejects on private channels.
SUPABASE_JWT_SECRET=

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# --- Resend (email) ---
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_FROM=
EMAIL_REPLY_TO=
STAFF_ALERT_EMAIL=

# --- Stripe ---
STRIPE_SECRET_KEY=
# Accepts a comma-separated list: the "Your account" and "Connected accounts"
# event destinations each mint their own signing secret.
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
PLATFORM_FEE_PERCENT=

# --- Sentry ---
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# --- AI providers ---
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=
AI_PROVIDER=

# --- PostHog ---
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
POSTHOG_KEY=
POSTHOG_HOST=

# --- Cloudflare Stream (video overlay feature, if shipped) ---
CF_ACCOUNT_ID=
CF_API_TOKEN=

# --- Relay / encryption (if relay feature shipped) ---
RELAY_KEK=

# --- Audit signing ---
AUDIT_SIGNING_KEY=
AUDIT_SIGNING_KEY_ID=
AUDIT_SIGNING_PREV_KEY_ID=
AUDIT_SIGNING_PREV_PUBKEY=
AUDIT_SIGNING_PREV_PUBKEYS=

# --- Placement service ---
PLACEMENT_SERVICE_HOST=
PLACEMENT_SERVICE_SECRET=
PLACEMENT_WALL_SECONDS=

# --- Scheduling AI ---
SCHEDULING_AI_BASE_URL=
SCHEDULING_AI_MODEL=
SCHEDULING_AI_CHEAP_MODEL=
SCHEDULING_AI_EFFORT=
SCHEDULING_AI_LADDER=
SCHEDULING_AI_MAX_TOKENS=
SCHEDULING_AI_ROUND_TIMEOUT_MS=
SCHEDULING_AI_THINKING=
SCHEDULING_AI_THINKING_BUDGET=
SCHEDULING_AI_ESCALATE_WARN_RATIO=
SCHEDULING_PARSE_MODEL=
SCHEDULING_REPAIR_BUDGET_MS=
SCHEDULING_REPAIR_SOLVER=
OFFICIALS_AI_EFFORT=
OFFICIALS_AI_LADDER=

# --- Misc runtime ---
CRON_SECRET=
CDN_PURGE_URL=
CDN_PURGE_TOKEN=
PEER_REVALIDATE=
REDIS_URL=
LOG_LEVEL=
# =enforce hardens CSP; defaults to report-only (proxy.ts).
CSP_MODE=
NEXT_PUBLIC_SCOREPAD_HOLD_MS=

# --- CI / e2e only — never set these in production ---
# Base64 of the same material as SUPABASE_JWT_PRIVATE_KEY. Exists only because
# GitHub Actions strips job-env vars whose NAME contains "PRIVATE_KEY"; do not
# rename it back. lib/realtime.ts falls back to it when the plain var is unset.
# SUPABASE_JWT_SIGNING_KEY_B64=
# Only needed when the signing key is an RSA PKCS8 key — a PKCS8 header does not
# encode its algorithm. This project's Supabase keys are ES256, which is the
# default when unset, so leave it alone.
# SUPABASE_JWT_ALG=
# e2e transfer destination (apps/web/e2e/rs007-money-kit.ts); a fabricated
# account id is rejected by Stripe.
# STRIPE_CONNECT_TEST_ACCOUNT=
# Gates the *.live.test.ts billing suites against Stripe TEST mode.
# BILLING_LIVE=
# Tripwire for nested db calls: =1 throws, =record enumerates (lib/db.ts).
# DB_NESTING_GUARD=

# --- Dev / test / bench only ---
