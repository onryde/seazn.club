# Copy to .env.local and fill in. See AGENTS.md / docs/superpowers for detail.
#
# Everything uncommented below is read by running application code. The
# commented blocks at the bottom are CI-, e2e- or bench-only and should NOT
# be set on a production machine.

# --- Core ---
DATABASE_URL=
DATABASE_SSL=
# Namespaces the schema (and the platform-settings cache key) — see lib/db.ts.
DB_SCHEMA=
DB_POOL_MAX=20
AUTH_SECRET=
# OAUTH_BASE_URL wins over NEXT_PUBLIC_BASE_URL for server-side redirect and
# canonical-URL resolution (lib/site-origin.ts) — Fly's proxy makes req.url the
# internal binding, so this must be set explicitly in prod.
OAUTH_BASE_URL=
NEXT_PUBLIC_BASE_URL=

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Realtime spectator JWT signing (lib/realtime.ts resolveRealtimeMintKey).
# This project uses Supabase ASYMMETRIC signing keys (JWKS ES256).
# Preferred: PKCS8 PEM or private JWK JSON of an imported signing key.
SUPABASE_JWT_PRIVATE_KEY=
# Optional, PEM branch only — the JWK branch takes the kid from the key itself.
SUPABASE_JWT_KID=
# Legacy fallback (long random shared secret). A UUID-shaped value here is a
# known misconfig: it is the JWKS kid, not a secret, and mints HS256 that
# Supabase rejects on private channels.
SUPABASE_JWT_SECRET=

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# --- Resend (email) ---
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_FROM=
EMAIL_REPLY_TO=
STAFF_ALERT_EMAIL=

# --- Stripe ---
STRIPE_SECRET_KEY=
# Accepts a comma-separated list: the "Your account" and "Connected accounts"
# event destinations each mint their own signing secret.
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
PLATFORM_FEE_PERCENT=

# --- Sentry ---
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# --- AI providers ---
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=
AI_PROVIDER=

# --- PostHog ---
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
POSTHOG_KEY=
POSTHOG_HOST=

# --- Cloudflare Stream (streaming relay: live inputs + recordings) ---
# Account the live inputs and recordings are created under. Required when RELAY_DRIVERS=live; unused in fake mode.
CLOUDFLARE_ACCOUNT_ID=
# API token scoped to Stream only. Server-side only, never a NEXT_PUBLIC_* var. Required when RELAY_DRIVERS=live.
CLOUDFLARE_STREAM_TOKEN=

# --- Relay / encryption ---
# Envelope key for stream keys and destination fingerprints: exactly 64 hex chars (openssl rand -hex 32). Required in both modes.
RELAY_KEK=
# fake | live: which provider adapters run. Unset or empty = fake (in-memory Cloudflare and Fly doubles, no network)
# in dev and test, but DISABLED under NODE_ENV=production (a production build, server.js): no drivers at all, and
# every stream start answers 503 ingest_unavailable. A production-build harness (CI, ci-local.sh, seazn-env) sets
# fake explicitly, with ENV_NAME "local" or "ci" beside it. Explicit fake is allowed only with ENV_NAME "local" or
# "ci" — or unset, outside production — so on stg/prod, and on a production build that names no environment, the
# boot check (instrumentation.ts) throws: the process stays up but answers 500 to every request until this is fixed,
# so a deployment can never hand a club a fake "live" stream.
RELAY_DRIVERS=
# stg | prod: this deployment's identity, stamped on every relay Machine; the daily sweep destroys only Machines carrying it.
# Set as a Fly secret. Live mode refuses when unset - lazily, at the first relay call that needs it (a composed start's
# Machine, the daily sweep), NOT at boot: a deploy without it starts and serves until then. Fake mode defaults to "local".
ENV_NAME=
# Fly Machines API token. Required for live composed streams (the first runner call fails without it); passthrough never uses it.
FLY_API_TOKEN=
# This deployment's OWN Fly app for relay Machines, one per environment (e.g. seazn-relay-stg / seazn-relay-prod).
# Never the retired shared "seazn-relay", which is refused. Set as a Fly secret; live mode refuses when unset, at the
# first runner call (not at boot).
FLY_RELAY_APP=
# The relay image relay Machines boot (registry.fly.io/<app>:<tag>). Required for live composed streams; unused in fake mode.
RELAY_IMAGE=
# The composed Machine's output profile: 1080p (default when unset; owner ruling 2026-10-27) or 720p (compositor ADR 0005).
# Anything else is refused.
# RELAY_OUTPUT_PROFILE=1080p
# R4 sponsors on stream: =1 passes RELAY_AIRINGS=1 into every composed Machine's env, which switches the compositor's sponsor
# airings (proof of play on the heartbeat) and proof frames on. Any other value, or unset, leaves them off. DEPLOY ORDER, as a
# Fly secret on the WEB app (never on the relay app; web builds the Machine env): 1) web with R4 PR A deployed; 2) the PRIVATE
# Supabase Storage bucket `sponsor-frames` exists; 3) the compositor with R4 PR C (airings + frame grab) deployed and its
# image in RELAY_IMAGE; only then 4) set RELAY_AIRINGS=1 on web. New Machines read it; a running stream keeps what it booted with.
# RELAY_AIRINGS=
# The daily sweep (POST /api/cron/relay-sweep) is guarded by CRON_SECRET, listed under "Misc runtime".
# Set BY FLY on every Machine (the deployed image ref; its sha tags relay telemetry rows). Never set it yourself.
# FLY_IMAGE_REF=
# Fake mode only: ms before a fake live input reports connected. Default 3000; 0 = at once.
# FAKE_INGEST_CONNECT_AFTER_MS=
# Test-only: =1 runs the *.live.test.ts Fly suites against the real API (needs FLY_API_TOKEN and FLY_RELAY_APP).
# RELAY_LIVE_FLY=
# Test-only: region for those live suites' Machines. Default lhr; production uses RUNNER_DEFAULT_REGION in relay/config.ts.
# FLY_RELAY_REGION=
# Envelope key for device-link secrets (scorer sheets). REQUIRED: without it, minting/printing scoring links fails closed (503).
# Exactly 64 hex chars (32 bytes). Separate from RELAY_KEK on purpose. Generate: openssl rand -hex 32
DEVICE_LINK_KEK=
# Envelope key for players' sealed Lichess OAuth tokens (chess design §3.1). REQUIRED for online chess: without it,
# linking an account and submitting a move both fail closed. Exactly 64 hex chars (32 bytes). Separate from
# DEVICE_LINK_KEK and RELAY_KEK on purpose — this one can move pieces in games that are not ours.
# Generate: openssl rand -hex 32
LICHESS_TOKEN_KEK=
# Envelope key for queued email bodies on the email outbox (a sign-in email carries a live credential). REQUIRED wherever
# RESEND_API_KEY is set: without it, the outbox refuses to queue and sign-in answers 500 (the server logs why at boot).
# Exactly 64 hex chars (32 bytes). Its OWN key, never LICHESS_TOKEN_KEK: rotating the Lichess key must not strand queued
# email. Do not use the sample in apps/web/.env.example; a production server refuses it. Generate: openssl rand -hex 32
EMAIL_OUTBOX_KEK=
# Envelope key for connected YouTube channels' sealed refresh tokens (YouTube Connect). REQUIRED to connect a channel: without
# it, connecting and every YouTube API call fail closed. Exactly 64 hex chars (32 bytes). Its OWN key, never RELAY_KEK: a
# refresh token acts AS the channel, and RELAY_KEK opens every stream key. Generate: openssl rand -hex 32
YOUTUBE_TOKEN_KEK=
# Which YouTube this process talks to: `fake` or `live` (YouTube Connect). Blank is unset: LIVE in production (NODE_ENV=production),
# the fake elsewhere. The fake and its e2e control routes answer only when ENV_NAME is local or ci, so stg and prod leave this
# blank and never set `fake`. Any other value picks nothing: the process still starts, Connect YouTube answers "not available" before it
# sends anyone to Google, and the fake's routes stay off - a typo is refused, never guessed.
YOUTUBE_DRIVER=
# The YouTube Connect callback, as registered in the Google Cloud console (an authorized redirect URI of the SAME OAuth client
# sign-in uses). Blank derives it: <base URL>/api/youtube/connect/callback. Set it when the base URL cannot be derived from the
# request (the e2e servers pin it to http://localhost:3000/...). Register the stg and prod URIs in the console first.
YOUTUBE_REDIRECT_URI=

# --- Audit signing ---
AUDIT_SIGNING_KEY=
AUDIT_SIGNING_KEY_ID=
AUDIT_SIGNING_PREV_KEY_ID=
AUDIT_SIGNING_PREV_PUBKEY=
AUDIT_SIGNING_PREV_PUBKEYS=

# --- Placement service ---
PLACEMENT_SERVICE_HOST=
PLACEMENT_SERVICE_SECRET=
PLACEMENT_WALL_SECONDS=

# --- Scheduling AI ---
SCHEDULING_AI_BASE_URL=
SCHEDULING_AI_MODEL=
SCHEDULING_AI_CHEAP_MODEL=
SCHEDULING_AI_EFFORT=
SCHEDULING_AI_LADDER=
SCHEDULING_AI_MAX_TOKENS=
SCHEDULING_AI_ROUND_TIMEOUT_MS=
SCHEDULING_AI_THINKING=
SCHEDULING_AI_THINKING_BUDGET=
SCHEDULING_AI_ESCALATE_WARN_RATIO=
SCHEDULING_PARSE_MODEL=
SCHEDULING_REPAIR_BUDGET_MS=
SCHEDULING_REPAIR_SOLVER=
OFFICIALS_AI_EFFORT=
OFFICIALS_AI_LADDER=

# --- Engine epoch floor override (emergency lever; default OFF) ---
# The scoring door refuses (426 ENGINE_OUTDATED) a write whose engine_epoch is below the sport's FOLD_EPOCH, so after a bump
# reaches prod every capture app still on the old epoch is locked out of that sport until it updates. This LOWERS the floor,
# per sport, on the server, with no code deploy (a Fly secret; restart to apply). Comma-separated sport=epoch pairs, an
# integer >= 1, whitespace allowed: ENGINE_EPOCH_FLOOR_OVERRIDE=football=2,hockey=1. It only ever LOWERS a floor, never raises
# it: an entry at or above the sport's own epoch does nothing (boot logs it as INERT). Unset or blank = off. A value that is
# not understood (unknown sport, epoch not an integer >= 1, a duplicate, an empty pair, a pair with no "=") is OFF: boot
# (instrumentation.ts) logs it as an error and reports it to Sentry as an exception, and the lever stays OFF (it does NOT stop the
# boot, unlike RELAY_DRIVERS: a typo in an emergency lever must not take the site down); the scoring gate reads it as OFF too, and
# reports it with log.error (and Sentry when that process initialised it) once, only when boot has not already reported that
# same value. Boot logs ENGINE_EPOCH_FLOOR_OVERRIDE_ACTIVE per
# sport, with how many majors behind (majorsBehind), and alerts Sentry: a warning for one major behind, an error for more than one
# (a forgotten entry); each request admitted only by the lever logs ENGINE_EPOCH_FLOOR_OVERRIDDEN (at most one line per request
# that passed the gate; never a Sentry Issue). Remove it once those apps have updated. Allowed in production (unlike the local/ci-only tunables). Leave it commented out unless you
# are using it.
# ENGINE_EPOCH_FLOOR_OVERRIDE=football=2

# --- Misc runtime ---
CRON_SECRET=
CDN_PURGE_URL=
CDN_PURGE_TOKEN=
PEER_REVALIDATE=
REDIS_URL=
LOG_LEVEL=
# =enforce hardens CSP; defaults to report-only (proxy.ts).
CSP_MODE=
NEXT_PUBLIC_SCOREPAD_HOLD_MS=

# --- CI / e2e only — never set these in production ---
# Base64 of the same material as SUPABASE_JWT_PRIVATE_KEY. Exists only because
# GitHub Actions strips job-env vars whose NAME contains "PRIVATE_KEY"; do not
# rename it back. lib/realtime.ts falls back to it when the plain var is unset.
# SUPABASE_JWT_SIGNING_KEY_B64=
# Only needed when the signing key is an RSA PKCS8 key — a PKCS8 header does not
# encode its algorithm. This project's Supabase keys are ES256, which is the
# default when unset, so leave it alone.
# SUPABASE_JWT_ALG=
# e2e transfer destination (apps/web/e2e/rs007-money-kit.ts); a fabricated
# account id is rejected by Stripe.
# STRIPE_CONNECT_TEST_ACCOUNT=
# Gates the *.live.test.ts billing suites against Stripe TEST mode.
# BILLING_LIVE=
# Tripwire for nested db calls: =1 throws, =record enumerates (lib/db.ts).
# DB_NESTING_GUARD=

