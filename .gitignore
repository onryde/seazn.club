# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/
# Playwright artifacts (also ignored in apps/web; this catches runs from the repo root)
test-results/
playwright-report/
# PROMPT-14 simulation failure artifacts (uploaded by CI, replayed via sim:replay)
sim-failures/
# Scheduler bench output (B01, tools/bench/). --keep is the default, so a
# local run leaves this populated with real, browsable data on purpose (bench
# design doc §10) — not something every run should add to git history. A
# specific run's report is committed deliberately as PR evidence with
# `git add -f` when a bench PR needs to show its own proof run, not by
# removing this entry.
bench-report/
# Format × sport matrix L3 output (W1a, tools/matrix/run.ts's default
# --report-dir): <runId>/results.json + MATRIX.md from a local live run.
matrix-report/

# next.js
.next/
out/

# production
build/

# python bytecode (tools/matrix/catalogue/scripts are run by hand and by catalogue-scripts.test.ts)
__pycache__/
*.pyc

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
scripts/.seed-demo-state.json
packages/engine/sim-report.json
# Stryker (W1d D14): the per-group reports and incremental files, and its sandbox copies of the engine.
packages/engine/reports/mutation/
packages/engine/SURVIVORS.md
packages/engine/.stryker-tmp/
.playwright-mcp/
# Superpowers visual-companion brainstorm sessions
.superpowers/

# Session screenshots keep landing in the repo root — never track them.
/*.png

# Turborepo
.turbo

# Subagent scratch memory. Agents write these under whatever package they are
# working in, so they appear as untracked dirs anywhere in the tree — and a
# single `git add -A` would commit twelve of them. Agent DEFINITIONS
# (.claude/agents/*.md) stay tracked; only the per-run memory is ignored.
**/.claude/agent-memory/

# Parse-bench run output. A billed sweep writes this on every run, so tracking
# it would put non-deterministic model answers in the diff of unrelated work.
# The corpus and the scorer ARE tracked; the results are not.
apps/web/parse-bench-results.json


# Local CI runner (scripts/ci-local.sh) reporter output
vitest-results-*.json

# Format-matrix truth runs: every run writes a shots/ tree (hundreds of PNGs)
# that stays local; only a finding crop under a run's evidence/ is committed
# (W1c Task 7/8 rulings; final review m-13).
docs/superpowers/specs/2026-09-27-format-matrix-prompts/truth-runs/**/shots/

# Hand-mutant runner self-test scratch dir (scripts/__tests__/mutate.test.ts): created and removed per run.
scripts/.mutate-selftest-*/
